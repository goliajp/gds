{
  "name": "@goliapkg/gds",
  "version": "1.0.5",
  "description": "GOLIA Design System — enterprise-grade UI component library with contextual depth, glass materials, AI-native structure, and 10 design principles",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "author": "GOLIA <dev@golia.jp> (https://golia.jp)",
  "homepage": "https://github.com/goliajp/gds#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goliajp/gds.git"
  },
  "bugs": {
    "url": "https://github.com/goliajp/gds/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "ui",
    "tailwindcss",
    "typescript",
    "ai-native",
    "glass-ui",
    "dark-mode",
    "enterprise"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens": {
      "import": "./dist/l0-tokens/index.js",
      "types": "./dist/l0-tokens/index.d.ts"
    },
    "./systems": {
      "import": "./dist/l1-systems/index.js",
      "types": "./dist/l1-systems/index.d.ts"
    },
    "./primitives": {
      "import": "./dist/l2-primitives/index.js",
      "types": "./dist/l2-primitives/index.d.ts"
    },
    "./atoms": {
      "import": "./dist/l3-atoms/index.js",
      "types": "./dist/l3-atoms/index.d.ts"
    },
    "./molecules": {
      "import": "./dist/l4-molecules/index.js",
      "types": "./dist/l4-molecules/index.d.ts"
    },
    "./organisms": {
      "import": "./dist/l5-organisms/index.js",
      "types": "./dist/l5-organisms/index.d.ts"
    },
    "./charts": {
      "import": "./dist/l6-charts/index.js",
      "types": "./dist/l6-charts/index.d.ts"
    },
    "./patterns": {
      "import": "./dist/l7-patterns/index.js",
      "types": "./dist/l7-patterns/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --config web/vite.config.ts --port 5175",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build": "bun run clean && bun run build:lib && bun run build:types && bun run build:css",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:css": "cp src/l0-tokens/tokens.css dist/tokens.css && cp src/l0-tokens/fonts.css dist/fonts.css && cp -r src/l0-tokens/fonts dist/fonts",
    "check": "bun run test && bun run typecheck && bun run lint"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.18.1",
    "lucide-react": "^0.577.0",
    "recharts": "^3.8.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "react-router": "^7.13.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "happy-dom": "^20.8.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.2",
    "vitest": "^4.1.1"
  }
}
