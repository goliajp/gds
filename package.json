{
  "name": "@goliapkg/gds",
  "private": true,
  "version": "0.0.1",
  "description": "GOLIA Design System v4 — rebuilt from scratch, one component at a time",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "workspaces": ["web"],
  "scripts": {
    "dev": "bun --filter @gds/web dev",
    "build": "bun --filter @gds/web build",
    "check": "bun --filter @gds/web check",
    "fix": "bun --filter @gds/web fix",
    "test": "bun --filter @gds/web test"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
